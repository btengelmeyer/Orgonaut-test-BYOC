# ---------------------------------------------------------------------------
# Orgonauts BYOC prototype — environment template
#
# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local
#
# `.env.local` is git-ignored. Never commit real credentials.
# Full setup instructions: README.md
# ---------------------------------------------------------------------------

# --- Google OAuth client (Google Cloud Console → APIs & Services → Credentials)

# OAuth 2.0 Client ID of type "Web application".
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Client secret paired with the ID above.
GOOGLE_CLIENT_SECRET=your-client-secret

# Must byte-for-byte match an "Authorized redirect URI" on that OAuth client.
# Google compares these as exact strings — a trailing slash will break it.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# --- Session encryption

# Key used to encrypt Google tokens inside the session cookie (AES-256-GCM).
# Must decode to exactly 32 bytes. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#
# Rotating this key invalidates every existing session; users simply re-link.
TOKEN_ENCRYPTION_KEY=generate-me-see-comment-above
